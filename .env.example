# Copy to .env and fill in. Never commit .env, and never paste these
# values into Slack or a commit message.

# Required. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 locally, 0 on any server.
DJANGO_DEBUG=1

# Production only. Comma separated, no protocol.
#   DJANGO_ALLOWED_HOSTS=woodlands.example.com
DJANGO_ALLOWED_HOSTS=

# Production only. Comma separated, with protocol.
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://woodlands.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Shift4 daily report mailbox (read-only IMAP). Not needed yet.
SHIFT4_REPORT_IMAP_HOST=
SHIFT4_REPORT_IMAP_USER=
SHIFT4_REPORT_IMAP_PASSWORD=
