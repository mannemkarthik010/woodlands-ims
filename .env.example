# Copy to .env and fill in. Never commit .env, and never paste these
# values into Slack or a commit message.

# Required. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 locally, 0 on any server.
DJANGO_DEBUG=1

# Production only. Comma separated, no protocol.
#   DJANGO_ALLOWED_HOSTS=woodlands.example.com
DJANGO_ALLOWED_HOSTS=

# Production only. Comma separated, with protocol.
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://woodlands.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Shift4 daily report mailbox (read-only IMAP). Not needed yet.
SHIFT4_REPORT_IMAP_HOST=
SHIFT4_REPORT_IMAP_USER=
SHIFT4_REPORT_IMAP_PASSWORD=

# Alerts. "RECORDED" writes the message and sends nothing, which is the safe
# default and what development should use. "SMS" sends text messages, which
# costs the client money -- only switch it on once they have agreed.
NOTIFY_CHANNEL=RECORDED

# Only needed when NOTIFY_CHANNEL=SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The kitchen's knowledge base. Searching the recipes always happens here and
# nothing leaves. "records" answers with the chef's own words. "claude" has a
# model write the answer from the retrieved passages, which sends those
# passages to Anthropic -- so it also needs KNOWLEDGE_CONSENT=1, which means
# the owners have agreed to that, informed, in advance.
KNOWLEDGE_ENGINE=records
KNOWLEDGE_CONSENT=0
KNOWLEDGE_API_KEY=
